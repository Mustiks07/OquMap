# Copy to .env and adjust. Placeholders only — never commit real secrets.

# Database (local development without Docker; Docker Compose sets its own URL)
OQUMAP_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/oqumap
POSTGRES_PASSWORD=change-me-local-only

# Where uploaded files are stored (outside the web root)
OQUMAP_STORAGE_DIR=./storage
# inline = jobs run in the API process; worker = run `python -m oqumap.worker`
OQUMAP_JOB_MODE=inline

# --- AI model provider (provider-agnostic; server-side only) ---------------------------------------
# none      — no model: deterministic templates (default; the analytics never depend on a model)
# recorded  — replay recorded synthetic outputs from data/demo/recorded/llm (offline demo, no network)
# gemini | openrouter | openai | anthropic — live model through the provider's HTTP API
OQUMAP_LLM_PROVIDER=none
# Exact model ID of the chosen provider; there is no runtime default. Recommended Gemini demo chain
# for synthetic data: gemini-3.8-flash -> gemini-3.5-flash-lite.
# Other providers: openrouter: <vendor>/<model>   openai: <model-id>   anthropic: claude-<model-id>
OQUMAP_LLM_MODEL=
# Only the key of the chosen provider is needed. Keys are never sent to the frontend, API responses, logs or exports.
OQUMAP_GEMINI_API_KEY=
OQUMAP_OPENROUTER_API_KEY=
OQUMAP_OPENAI_API_KEY=
OQUMAP_ANTHROPIC_API_KEY=
# Optional base URLs (proxies / compatible gateways)
# OQUMAP_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# OQUMAP_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OQUMAP_OPENAI_BASE_URL=https://api.openai.com/v1
# OQUMAP_ANTHROPIC_BASE_URL=https://api.anthropic.com
# Gemini free tier may use prompts to improve Google products: synthetic data only. Set true ONLY for a paid
# (Cloud Billing) project whose terms exclude training.
OQUMAP_GEMINI_PAID_TIER=false
# Real (non-synthetic) data is never sent to a live model unless explicitly allowed AND the provider's data
# policy is not may_train / depends_on_route. Keep false for demos.
OQUMAP_LLM_REAL_DATA_ALLOWED=false
# Explicit fallbacks "provider:model", tried in order. A different provider receives the same data, so it
# additionally requires OQUMAP_LLM_ALLOW_CROSS_PROVIDER_FALLBACK=true and is recorded as an audit event.
OQUMAP_LLM_FALLBACKS=[]
# Same-provider Gemini fallback example (enable only after choosing Gemini above):
# OQUMAP_LLM_FALLBACKS=["gemini:gemini-3.5-flash-lite"]
OQUMAP_LLM_ALLOW_CROSS_PROVIDER_FALLBACK=false
# Limits
OQUMAP_LLM_TIMEOUT_SECONDS=30
OQUMAP_LLM_MAX_RETRIES=2
OQUMAP_LLM_MAX_INPUT_CHARS=24000
OQUMAP_LLM_MAX_OUTPUT_TOKENS=1500
OQUMAP_LLM_LIVE_ROLES=["methodist","approver"]
OQUMAP_LLM_LIVE_PER_ORG_PER_DAY=200
OQUMAP_LLM_LIVE_PER_USER_PER_HOUR=40
OQUMAP_LLM_MAX_TOKENS_PER_ORG_PER_DAY=300000

# OCR adapter: none | tesseract (requires the tesseract binary with rus+kaz+eng data)
OQUMAP_OCR_ENGINE=none
